# analytics-engineering/Dockerfile.duckdb
FROM python:3.11-slim

# Install uv
RUN pip install --no-cache-dir uv

# Install dbt and duckdb using uv
RUN uv pip install --system --no-cache \
    dbt-core \
    dbt-duckdb \
    dbt-postgres \
    duckdb \
    jupyter

# Create a directory for dbt
WORKDIR /workspace

# Default command
CMD ["/bin/bash"]